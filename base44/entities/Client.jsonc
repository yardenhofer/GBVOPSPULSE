{
  "name": "Client",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Client company name"
    },
    "group": {
      "type": "number",
      "description": "Group number this client belongs to"
    },
    "package_type": {
      "type": "string",
      "enum": [
        "Email",
        "LinkedIn",
        "Hybrid"
      ]
    },
    "assigned_am": {
      "type": "string",
      "description": "Email of assigned Account Manager"
    },
    "assigned_pm": {
      "type": "string",
      "description": "Email of assigned Project Manager"
    },
    "status": {
      "type": "string",
      "enum": [
        "Healthy",
        "Monitor",
        "At Risk",
        "Critical",
        "Off-Boarding",
        "Terminated"
      ],
      "default": "Healthy"
    },
    "status_override": {
      "type": "string",
      "enum": [
        "Healthy",
        "Monitor"
      ],
      "description": "Admin override to suppress auto-calculated At Risk / Critical status"
    },
    "client_sentiment": {
      "type": "string",
      "enum": [
        "Happy",
        "Neutral",
        "Slightly Concerned",
        "Unhappy"
      ],
      "default": "Happy"
    },
    "unhappy_since": {
      "type": "string",
      "format": "date"
    },
    "revenue": {
      "type": "number",
      "description": "Monthly revenue"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "contract_end_date": {
      "type": "string",
      "format": "date",
      "description": "Contract renewal / expiry date"
    },
    "min_contract_months": {
      "type": "number",
      "description": "Minimum contract term in months"
    },
    "target_leads_per_week": {
      "type": "number"
    },
    "leads_this_week": {
      "type": "number",
      "default": 0
    },
    "leads_last_week": {
      "type": "number",
      "default": 0
    },
    "leads_week_3": {
      "type": "number",
      "default": 0,
      "description": "Leads 3 weeks ago"
    },
    "leads_week_4": {
      "type": "number",
      "default": 0,
      "description": "Leads 4 weeks ago"
    },
    "meetings_booked": {
      "type": "number",
      "default": 0
    },
    "close_rate": {
      "type": "number"
    },
    "waiting_on_leads": {
      "type": "boolean",
      "default": false
    },
    "waiting_since": {
      "type": "string",
      "format": "date"
    },
    "last_am_touchpoint": {
      "type": "string",
      "format": "date"
    },
    "last_client_reply_date": {
      "type": "string",
      "format": "date"
    },
    "is_escalated": {
      "type": "boolean",
      "default": false
    },
    "client_feedback": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "onboarding_contract_signed": {
      "type": "boolean",
      "default": false
    },
    "onboarding_lead_list_received": {
      "type": "boolean",
      "default": false
    },
    "onboarding_campaign_live": {
      "type": "boolean",
      "default": false
    },
    "onboarding_kickoff_done": {
      "type": "boolean",
      "default": false
    },
    "onboarding_crm_connected": {
      "type": "boolean",
      "default": false
    },
    "onboarding_stage": {
      "type": "string",
      "enum": [
        "Infrastructure Ordered",
        "Infrastructure In Process",
        "Infrastructure Uploaded",
        "Infrastructure Live"
      ],
      "description": "Current onboarding infrastructure stage"
    },
    "onboarding_stage_date": {
      "type": "string",
      "format": "date"
    },
    "instantly_api_key": {
      "type": "string"
    },
    "instantly_cache_pct": {
      "type": "number"
    },
    "instantly_cache_no_active": {
      "type": "boolean",
      "default": false
    },
    "instantly_cache_error": {
      "type": "string"
    },
    "instantly_cache_updated": {
      "type": "string",
      "format": "date-time"
    },
    "slack_channel_id": {
      "type": "string"
    },
    "slack_channel_name": {
      "type": "string"
    },
    "dq_link": {
      "type": "string"
    },
    "email_copy": {
      "type": "string"
    },
    "inbox_placement_screenshot": {
      "type": "string"
    },
    "inbox_placement_uploaded_at": {
      "type": "string",
      "format": "date-time"
    },
    "inbox_placement_uploaded_by": {
      "type": "string"
    },
    "terminated_date": {
      "type": "string",
      "format": "date"
    },
    "offboarding_slack_ts": {
      "type": "string"
    },
    "offboarding_slack_channel": {
      "type": "string"
    },
    "offboarding_confirmed": {
      "type": "boolean",
      "default": false
    },
    "offboarding_date": {
      "type": "string",
      "format": "date"
    },
    "last_offboard_reminder_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "name"
  ]
}