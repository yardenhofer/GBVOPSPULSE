{
  "name": "Porkbun Nameserver Sync (every 15 min)",
  "description": "Automatically applies required Cloudflare nameservers to Porkbun domains for all eligible tenants. Respects the use_scalesends_autofix feature flag. Rate-limited to 10s between domains.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 15,
      "interval_unit": "minutes",
      "interval_anchor": "2026-04-22T15:49:14.060000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "porkbun_nameserver_sync_every_15_min",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "porkbunNameservers",
            "args": {
              "action": "syncAll"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "porkbunNameservers"
  }
}