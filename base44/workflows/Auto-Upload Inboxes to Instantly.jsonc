{
  "name": "Auto-Upload Inboxes to Instantly",
  "description": "When Scalesends marks inboxes as complete and a workspace is assigned, automatically upload the inboxes to the selected Instantly workspace.",
  "trigger": {
    "condition": "${ ((.trigger.data.scalesends_status == \"complete\") and (.trigger.data.instantly_workspace_id != null and .trigger.data.instantly_workspace_id != \"\" and .trigger.data.instantly_workspace_id != [] and .trigger.data.instantly_workspace_id != {}) and (.trigger.changed_fields | index(\"scalesends_status\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "TenantLifecycle"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_upload_inboxes_to_instantly",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "instantlyAutoUpload",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "instantlyAutoUpload"
  }
}