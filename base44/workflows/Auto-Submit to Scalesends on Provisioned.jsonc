{
  "name": "Auto-Submit to Scalesends on Provisioned",
  "description": "When a tenant reaches tenant_provisioned status (credentials captured from email), automatically submit to Scalesends if auto-submit is enabled.",
  "trigger": {
    "condition": "${ ((.trigger.data.overall_status == \"tenant_provisioned\") and (.trigger.changed_fields | index(\"overall_status\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "TenantLifecycle"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_submit_to_scalesends_on_provisioned",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "scalesendsAutoSubmit",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "scalesendsAutoSubmit"
  }
}